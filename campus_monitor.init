#!/bin/sh /etc/rc.common
# ============================================
# 校园网监控守护进程服务 (procd)
# 安装:
#   scp campus_monitor.init root@路由器:/etc/init.d/campus_monitor
#   chmod +x /etc/init.d/campus_monitor
#   /etc/init.d/campus_monitor enable
#   /etc/init.d/campus_monitor start
# 管理:
#   /etc/init.d/campus_monitor {start|stop|restart|status|enable|disable}
#   logread -e campus_monitor        # 查看运行日志
# ============================================

START=99
STOP=10
USE_PROCD=1

PROG=/etc/xiaoyuan/campus_monitor.sh

start_service() {
    if [ ! -f "$PROG" ]; then
        logger -t campus_monitor "启动失败: $PROG 不存在, 请先上传脚本"
        return 1
    fi
    procd_open_instance
    procd_set_param command /bin/sh "$PROG"
    # 崩溃自动拉起: 3600 秒内最多重启 5 次, 每次间隔 5 秒
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    logger -t campus_monitor "守护进程已停止"
}

service_triggers() {
    procd_add_reload_trigger "campus_monitor"
}
