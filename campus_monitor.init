#!/bin/sh /etc/rc.common
# ============================================
# 校园网实时监控服务 (OpenWrt / ImmortalWrt procd)
# 开机自启, 进程崩溃自动拉起
# 部署: cp 到 /etc/init.d/campus_monitor; chmod +x; 
#       /etc/init.d/campus_monitor enable; /etc/init.d/campus_monitor start
# ============================================

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /etc/xiaoyuan/campus_monitor.sh
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
